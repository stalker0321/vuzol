# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim@sha256:53ada149d435c38b14476cb57e4a7da73c15595aba79bd6971b547ceb6d018bf

ARG CODEX_VERSION=0.144.1
ARG KIMI_CODE_VERSION=0.31.1
ARG GROK_VERSION=0.2.99
ARG GROK_SHA256=9fccba400d3808ec34a991892096b34c6f5846b2b118d355001601fd5428445c
ARG SAFE_CHAIN_VERSION=1.5.15
ARG SAFE_CHAIN_INSTALLER_SHA256=de0565e3d6346407a604e84e639e95fea8758748063da2216bbfdca5feda5dd2

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl git make \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global "@openai/codex@${CODEX_VERSION}" "@moonshot-ai/kimi-code@${KIMI_CODE_VERSION}" \
    && curl --fail --silent --show-error --location \
        "https://github.com/AikidoSec/safe-chain/releases/download/${SAFE_CHAIN_VERSION}/install-safe-chain.sh" \
        --output /tmp/install-safe-chain.sh \
    && echo "${SAFE_CHAIN_INSTALLER_SHA256}  /tmp/install-safe-chain.sh" | sha256sum --check --strict \
    && SAFE_CHAIN_VERSION="${SAFE_CHAIN_VERSION}" sh /tmp/install-safe-chain.sh --ci --install-dir /opt/safe-chain \
    && rm /tmp/install-safe-chain.sh \
    && curl --fail --silent --show-error --location \
        "https://x.ai/cli/grok-${GROK_VERSION}-linux-x86_64" \
        --output /usr/local/bin/grok \
    && echo "${GROK_SHA256}  /usr/local/bin/grok" | sha256sum --check --strict \
    && chmod 0755 /usr/local/bin/grok \
    && groupadd --system --gid 10001 sandbox \
    && useradd --system --uid 10001 --gid sandbox --no-create-home sandbox \
    && mkdir -p /workspace /artifacts /codex-home /grok-home /kimi-home \
    && chown 10001:10001 /workspace /artifacts /codex-home /grok-home /kimi-home

ENV PATH=/opt/safe-chain/shims:/opt/safe-chain/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    SAFE_CHAIN_MINIMUM_PACKAGE_AGE_HOURS=48 \
    SAFE_CHAIN_LOGGING=silent

USER 10001:10001
WORKDIR /workspace

ENTRYPOINT []
CMD ["codex", "--version"]
