# Managed by deploy/production. Do not add drop-ins; edit this file and redeploy.
[Unit]
Description=Vuzol narrow approved-result and capability worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vuzol-executor
Group=vuzol-executor
EnvironmentFile=/etc/vuzol/vuzol.env
EnvironmentFile=/etc/vuzol/applier.env
EnvironmentFile=/etc/vuzol/secrets.env
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
ReadOnlyPaths=/srv/vuzol/worktrees /etc/vuzol /var/lib/vuzol/registry
ReadWritePaths=/srv/vuzol/repositories /srv/vuzol/artifacts -/var/lib/vuzol/toolchains -/var/lib/vuzol/capability-downloads
WorkingDirectory=/opt/vuzol/current
ExecStart=/opt/vuzol/current/.venv/bin/python -m vuzol.cli.applier

[Install]
WantedBy=multi-user.target
