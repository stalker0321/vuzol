# Managed by deploy/production. Do not add drop-ins; edit this file and redeploy.
[Unit]
Description=Vuzol daily health summary to the owner's system topic
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=vuzol-executor
Group=vuzol-executor
EnvironmentFile=/etc/vuzol/vuzol.env
EnvironmentFile=/etc/vuzol/secrets.env
# VUZOL_TELEGRAM_BOT_TOKEN, VUZOL_HEALTH_CHAT_ID, VUZOL_HEALTH_THREAD_ID (root 0600).
EnvironmentFile=/etc/vuzol/health-report.env
WorkingDirectory=/opt/vuzol/current
ExecStart=/opt/vuzol/current/.venv/bin/python -m vuzol.cli.health_report --usage-file /var/lib/vuzol/usage-export/opencode-c/usage.json
TimeoutStartSec=2m
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/etc/vuzol /var/lib/vuzol/registry
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
