# Managed by deploy/production. Do not add drop-ins; edit this file and redeploy.
[Unit]
Description=Vuzol OpenCode usage export and serialized CLI OAuth maintenance
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=vodkolyan
Group=vodkolyan
WorkingDirectory=/opt/vuzol/current
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/vuzol/current/.venv/bin/python -m vuzol.cli.opencode_usage_export --setup /etc/vuzol/opencode-usage.json
# Each account with a console login, one after another.
TimeoutStartSec=170
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
# The shared logins live here, not in a home directory (accounts_root in the setup).
ReadWritePaths=/var/lib/vuzol/opencode-shared /var/lib/vuzol/usage-export
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
StandardOutput=journal
StandardError=journal

