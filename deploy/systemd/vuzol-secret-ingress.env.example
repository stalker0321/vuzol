VUZOL_ENVIRONMENT=production
VUZOL_SERVICE_NAME=vuzol
VUZOL_HOST=127.0.0.1
VUZOL_PORT=8088
VUZOL_DATABASE_DSN_REFERENCE=file:database-dsn
VUZOL_SECRET_FILE_ROOT=/run/secrets
VUZOL_SECRET_INGRESS__ENABLED=true
VUZOL_SECRET_INGRESS__PUBLIC_BASE_URL=https://vuzol.example.com
VUZOL_SECRET_INGRESS__STORAGE_ROOT=/var/lib/vuzol-managed-secrets
VUZOL_SECRET_INGRESS__ALLOWED_NAMES='["TOKENROUTER_API_KEY"]'
VUZOL_SECRET_INGRESS__TTL_SECONDS=300
