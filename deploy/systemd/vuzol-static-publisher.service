[Unit]
Description=Vuzol allowlisted static project publisher
After=local-fs.target

[Service]
Type=oneshot
User=vuzol-publisher
Group=vuzol-publisher
ExecStart=/opt/vuzol/.venv/bin/vuzol-static-publisher
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
ReadOnlyPaths=/srv/vuzol/repositories /etc/vuzol/static-sites.json
ReadWritePaths=/srv/vuzol/sites

