{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vuzol.local/schemas/horizon.v1.json",
  "title": "Horizon v1",
  "description": "Bounded working horizon: goal, acceptance, lifetime budget and permission envelope reference. Owner = runtime. PostgreSQL is the source of truth for ownership/status; Git/artifact hashes are content truth. Evolves the existing WorkPackage row additively; the SQL table is not renamed here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "horizon_id",
    "goal_revision",
    "goal",
    "exit_criteria",
    "lifetime_budget",
    "permission_envelope_hash",
    "status",
    "owner",
    "version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema": { "const": "horizon.v1" },
    "horizon_id": { "type": "string", "format": "uuid" },
    "goal_revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic semantic revision of goal/acceptance. A correction after start is a new revision, never a retroactive success rewrite."
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement"],
      "properties": {
        "statement": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "goal_id": {
          "type": ["string", "null"],
          "format": "uuid",
          "description": "Optional stable goal identity. v1 keeps Goal as a field, not a separate aggregate."
        }
      }
    },
    "exit_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "statement", "evidence_kind", "observable"],
        "properties": {
          "criterion_id": { "type": "string", "minLength": 1, "maxLength": 100 },
          "statement": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "evidence_kind": {
            "enum": ["test_report", "artifact_hash", "acceptance_report", "research_result", "diff_commit"]
          },
          "observable": {
            "type": "boolean",
            "description": "False means the criterion is qualitative and needs a bound acceptance evaluation, not a bare test count."
          }
        }
      }
    },
    "deadline": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Deadline transitions by policy (checkpoint/partial/stop), never a synthetic success."
    },
    "lifetime_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "pricing_revision", "unknown_cost_policy"],
      "properties": {
        "currency": { "type": "string", "minLength": 1, "maxLength": 16 },
        "pricing_revision": { "type": "string", "minLength": 1, "maxLength": 100 },
        "max_cost": { "type": ["number", "null"], "minimum": 0 },
        "max_attempts": { "type": ["integer", "null"], "minimum": 1 },
        "unknown_cost_policy": { "const": "reserve_conservative" },
        "note": {
          "const": "Lifetime budget survives retry epochs and new Tasks; a retry must not reset it."
        }
      }
    },
    "permission_envelope_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 of the PermissionEnvelope in force. The envelope itself is a separate record; only its hash is referenced here."
    },
    "approved_plan_revision_id": { "type": ["string", "null"], "format": "uuid" },
    "status": {
      "enum": [
        "draft",
        "ready",
        "running",
        "evaluating",
        "succeeded",
        "waiting_resource",
        "waiting_approval",
        "waiting_input",
        "paused",
        "failed",
        "cancelled"
      ]
    },
    "owner": { "const": "runtime" },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Optimistic-concurrency row version, distinct from goal_revision and lease generation."
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
