{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vuzol.local/schemas/research-result.v1.json",
  "title": "Research result v1",
  "description": "Verifiable research artifact (WP06): every factual claim links to a retrieved source/position; unsupported claims are marked, never silent. Timestamps/hash/scope are stored per source. Without retrieval there is no verified research.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "research_id", "question", "sources", "claims", "created_at"],
  "properties": {
    "schema": { "const": "research-result.v1" },
    "research_id": { "type": "string", "format": "uuid" },
    "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "uri",
          "retriever",
          "retrieved_at",
          "content_hash",
          "scope",
          "freshness_class"
        ],
        "properties": {
          "source_id": { "type": "string", "minLength": 1, "maxLength": 100 },
          "uri": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "retriever": {
            "type": "string",
            "enum": ["approved-http", "local-docs-fixture"],
            "description": "Which retrieval integration produced this source. Live web outside the approved adapter is forbidden."
          },
          "retrieved_at": { "type": "string", "format": "date-time" },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of the retrieved bytes the claim positions point into."
          },
          "scope": { "type": "string", "minLength": 1, "maxLength": 200 },
          "freshness_class": { "type": "string", "enum": ["fresh", "stale"] },
          "quote": { "type": "string", "maxLength": 2000 }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "statement", "support"],
        "properties": {
          "claim_id": { "type": "string", "minLength": 1, "maxLength": 100 },
          "statement": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "support": {
            "type": "string",
            "enum": ["supported", "unsupported", "conflicting"],
            "description": "unsupported = no retrieved source backs this claim; conflicting = sources disagree (both cited)."
          },
          "citations": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "position"],
              "properties": {
                "source_id": { "type": "string", "minLength": 1, "maxLength": 100 },
                "position": { "type": "string", "minLength": 1, "maxLength": 500 }
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "support": { "const": "supported" } } },
            "then": { "required": ["citations"], "properties": { "citations": { "minItems": 1 } } }
          },
          {
            "if": { "properties": { "support": { "const": "conflicting" } } },
            "then": { "required": ["citations"], "properties": { "citations": { "minItems": 2 } } }
          }
        ]
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
